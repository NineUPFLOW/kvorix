#!/bin/bash
set -euo pipefail
umask 077
python3 -c "import secrets; open('/etc/kvorix/novnc.token.new','w').write(secrets.token_hex(24))"
chmod 600 /etc/kvorix/novnc.token.new
T=$(cat /etc/kvorix/novnc.token.new)
cat > /etc/kvorix/novnc-nginx.inc.new <<EOF
    location / { return 404; }
    location = /$T { return 302 /$T/vnc.html; }
    location /$T/websockify {
        proxy_pass http://127.0.0.1:6081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
    location /$T/ {
        alias /usr/share/novnc/;
        index vnc.html;
    }
EOF
nginx -t -c /etc/nginx/nginx.conf 2>/dev/null || true
mv /etc/kvorix/novnc-nginx.inc.new /etc/kvorix/novnc-nginx.inc
mv /etc/kvorix/novnc.token.new /etc/kvorix/novnc.token
nginx -t && systemctl reload nginx
echo "новая ссылка: http://<IP бокса>:6080/$T/vnc.html"
