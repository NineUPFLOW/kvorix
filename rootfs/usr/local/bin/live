#!/bin/bash
L=/tmp/live.log
JENV="DISPLAY=:0 XAUTHORITY=/home/agent/.Xauthority DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus XDG_RUNTIME_DIR=/run/user/1001"

open_window() {
    if ! pgrep -f 'tail -n 40 -F /tmp/live[.]log' >/dev/null 2>&1; then
        env $JENV setsid xfce4-terminal --title="Журнал агента" --geometry=96x28+50+50 \
            --font="Monospace 11" -x tail -n 40 -F /tmp/live.log >/dev/null 2>&1 < /dev/null &
    fi
}
ensure_watchdog() {
    local old; old=$(cat /tmp/.live-journal-close.pid 2>/dev/null || true)
    [ -n "$old" ] && kill "$old" 2>/dev/null
    setsid bash -c '
        echo $$ > /tmp/.live-journal-close.pid
        end=$(( $(date +%s) + 1800 ))
        while [ "$(date +%s)" -lt "$end" ]; do
            sleep 15
            age=$(( $(date +%s) - $(stat -c %Y /tmp/live.log 2>/dev/null || echo 0) ))
            [ "$age" -ge 300 ] && break
        done
        rm -f /tmp/.live-journal-close.pid
        pkill -f "tail -n 40 -F /tmp/live[.]log" 2>/dev/null
        exit 0
    ' >/dev/null 2>&1 < /dev/null &
}
case "${1:-}" in --show|show) [ "${KVORIX_JOURNAL_BUTTON:-}" = 1 ] && open_window && ensure_watchdog; exit 0;; esac
ensure_watchdog
printf '\n\033[1;36m%s\033[0m \033[1;33m$\033[0m %s\n' "$(date +%H:%M:%S)" "$*" >> $L
bash -c "$*" 2>&1 | tee -a $L
exit ${PIPESTATUS[0]}
