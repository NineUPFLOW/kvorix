#!/usr/bin/env python3

import os
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

try:
    CFG = "/var/lib/hdmi-autodetect/" + open("/run/hdmi-monitor").read().strip()
except OSError:
    CFG = os.path.expanduser("~/.config/armbian-tv/display-mode")
MODES = [("auto", "Автоматически — родной режим монитора (по EDID)"),
         ("1920x1080_60", "1920 × 1080 — Full HD (большинство мониторов и ТВ)"),
         ("1680x1050_60", "1680 × 1050 — мониторы 16:10"),
         ("1600x900_60", "1600 × 900"),
         ("1440x900_60", "1440 × 900 — мониторы 16:10"),
         ("1366x768_60", "1366 × 768 — ноутбучные панели и ТВ HD Ready"),
         ("1280x1024_60", "1280 × 1024 — квадратные мониторы 5:4"),
         ("1280x720_60", "1280 × 720 — HD"),
         ("fit", "Подгонка границ под ТВ (если края обрезаны)")]


def sh(*a):
    return subprocess.run(a, capture_output=True, text=True)


def output():
    for l in sh("xrandr").stdout.splitlines():
        if " connected" in l:
            return l.split()[0]


def current():
    for l in sh("xrandr").stdout.splitlines():
        if "*" in l:
            return l.split()[0]


def apply(mode):
    if mode == "fit":
        return sh("armbian-screen-fit").returncode == 0
    if mode == "auto":
        return sh("xrandr", "--output", output(), "--auto").returncode == 0
    return sh("xrandr", "--output", output(), "--mode", mode).returncode == 0


def restart_shell():
    subprocess.run("pkill -f 'rsaarm-[t]askbar.py'; P=$(cat /tmp/rsaarm-menu-$(id -u).pid 2>/dev/null);"
                   " [ -n \"$P\" ] && kill $P", shell=True)


subprocess.run(["armbian-display-auto", "--modes-only"])
prev = current()
win = Gtk.Window(title="Разрешение экрана")
win.set_position(Gtk.WindowPosition.CENTER)
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=18)
win.add(box)
info = Gtk.Label(xalign=0)
info.set_line_wrap(True)
info.set_max_width_chars(60)
info.set_markup("<b>Разрешение экрана</b>\n"
                "Обычно режим подбирается сам по паспорту монитора (EDID). Выбор здесь "
                "запоминается для этого монитора. Если экран погаснет — подождите 15 секунд, "
                "вернётся прежний режим.")
box.pack_start(info, False, False, 0)
group = None
radios = {}
for key, title in MODES:
    r = Gtk.RadioButton.new_with_label_from_widget(group, title)
    group = group or r
    radios[key] = r
    box.pack_start(r, False, False, 0)
saved = open(CFG).read().strip() if os.path.exists(CFG) else ""
radios.get(saved or "auto", radios["auto"]).set_active(True)


def on_apply(*a):
    key = next(k for k, r in radios.items() if r.get_active())
    if not apply(key):
        info.set_text("Этот режим не применился. Выберите другой.")
        return
    left = [15]
    d = Gtk.MessageDialog(transient_for=win, modal=True, message_type=Gtk.MessageType.QUESTION,
                          buttons=Gtk.ButtonsType.NONE, text="Оставить этот режим?")
    d.add_buttons("Вернуть", Gtk.ResponseType.CANCEL, "Оставить", Gtk.ResponseType.OK)

    def tick():
        left[0] -= 1
        d.format_secondary_text("Возврат к прежнему режиму через %d с" % left[0])
        if left[0] <= 0:
            d.response(Gtk.ResponseType.CANCEL)
            return False
        return True

    tick()
    t = GLib.timeout_add(1000, tick)
    resp = d.run()
    GLib.source_remove(t) if left[0] > 0 else None
    d.destroy()
    if resp == Gtk.ResponseType.OK:
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        if key == "auto":
            if os.path.exists(CFG):
                os.remove(CFG)
        else:
            open(CFG, "w").write(key)
        restart_shell()
        Gtk.main_quit()
    else:
        sh("xrandr", "--output", output(), "--mode", prev)


btn = Gtk.Button(label="Применить")
btn.get_style_context().add_class("suggested-action")
btn.connect("clicked", on_apply)
box.pack_end(btn, False, False, 6)
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
