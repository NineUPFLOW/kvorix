#!/usr/bin/env python3

import json

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

CFG = "/var/lib/front-panel/config.json"
SCREENS = [("clock", "Часы 12:34 (двоеточие мигает)"), ("date", "Дата 01:11 (день:месяц)"),
           ("temp", "Температура процессора  58C"), ("cpu", "Загрузка процессора, %  C 12"),
           ("ram", "Занятая память, %  R 45"), ("disk", "Занятый диск, %  D 49"),
           ("wifi", "Сигнал Wi-Fi, дБм  -67"), ("node", "Узел кластера  N1ON / N1--"),
           ("uptime", "Время работы 03:25 (часы:минуты)")]
try:
    cfg = json.load(open(CFG))
except (OSError, ValueError):
    cfg = {}
cfg = dict({"screens": ["clock", "temp", "cpu", "ram", "node"], "seconds": 5, "brightness": 7,
            "night": True}, **cfg)

win = Gtk.Window(title="Передняя панель")
win.set_default_size(440, -1)
win.set_position(Gtk.WindowPosition.CENTER)
box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=18)
win.add(box)
h = Gtk.Label(xalign=0)
h.set_markup("<b>Что показывать на индикаторе корпуса</b>\nВыбранные экраны сменяют друг друга по кругу. "
             "При тревоге (узел недоступен, перегрев) нужный экран добавляется сам.")
h.set_line_wrap(True)
box.pack_start(h, False, False, 0)
checks = {}
for key, title in SCREENS:
    c = Gtk.CheckButton(label=title)
    c.set_active(key in cfg["screens"])
    checks[key] = c
    box.pack_start(c, False, False, 0)


def spin_row(title, lo, hi, val):
    r = Gtk.Box(spacing=10)
    r.pack_start(Gtk.Label(label=title, xalign=0), True, True, 0)
    s = Gtk.SpinButton.new_with_range(lo, hi, 1)
    s.set_value(val)
    r.pack_start(s, False, False, 0)
    box.pack_start(r, False, False, 0)
    return s


sec = spin_row("Секунд на каждый экран", 2, 60, cfg["seconds"])
bri = spin_row("Яркость (0–7)", 0, 7, cfg["brightness"])
night = Gtk.CheckButton(label="Ночью (22:00–07:00) приглушать")
night.set_active(cfg["night"])
box.pack_start(night, False, False, 0)
status = Gtk.Label(xalign=0)
box.pack_start(status, False, False, 0)


def save(*a):
    new = {"screens": [k for k, _ in SCREENS if checks[k].get_active()] or ["clock"],
           "seconds": int(sec.get_value()), "brightness": int(bri.get_value()),
           "night": night.get_active()}
    try:
        with open(CFG, "w") as f:
            json.dump(new, f, ensure_ascii=False)
        status.set_text("Сохранено — индикатор уже обновился.")
    except OSError as e:
        status.set_text("Не удалось сохранить: %s" % e)


btn = Gtk.Button(label="Применить")
btn.get_style_context().add_class("suggested-action")
btn.connect("clicked", save)
box.pack_end(btn, False, False, 0)
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
