#!/usr/bin/env python3

import math
import os
import subprocess

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango, Wnck


class TaskView(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Представление задач")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_resizable(False)

        dark = False
        try:
            with open(os.path.expanduser("~/.config/rsaarm/theme")) as f:
                dark = f.read().strip() == "dark"
        except OSError:
            pass

        bg = "#1c202b" if dark else "#f5f7fc"
        card = "#252b39" if dark else "#ffffff"
        fg = "#eef1f8" if dark else "#1c2130"
        dim = "#9aa2b4" if dark else "#5e6678"
        brd = "#353d50" if dark else "#d4dae6"
        css = f"""
        .tv-root {{ background-color: {bg}; color: {fg}; padding: 18px 20px; font: 11px "Inter"; }}
        .tv-h {{ font: bold 14px "Inter"; color: {fg}; }}
        .tv-sub {{ font: 11px "Inter"; color: {dim}; }}
        .tv-card {{
            background-color: {card};
            border: 1px solid {brd};
            border-radius: 12px;
            padding: 10px 12px;
        }}
        .tv-btn {{
            background: transparent;
            border: none;
            border-radius: 8px;
            padding: 6px 9px;
            color: {fg};
            font: bold 11px "Inter";
        }}
        .tv-btn:hover {{ background: rgba(47, 124, 246, 0.16); color: #2f7cf6; }}
        .tv-close:hover {{ background: #c42b1c; color: #ffffff; }}
        """
        pr = Gtk.CssProvider()
        pr.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), pr, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        W, H = 760, 470
        self.set_default_size(W, H)
        self.set_size_request(W, H)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.get_style_context().add_class("tv-root")
        self.add(root)

        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hl = Gtk.Label(label="Открытые окна и привязка к экрану")
        hl.get_style_context().add_class("tv-h")
        hdr.pack_start(hl, False, False, 0)
        hdr.pack_start(Gtk.Box(), True, True, 0)
        xb = Gtk.Button(label="✕ Закрыть")
        xb.get_style_context().add_class("tv-btn")
        xb.get_style_context().add_class("tv-close")
        xb.connect("clicked", lambda *_: Gtk.main_quit())
        hdr.pack_start(xb, False, False, 0)
        root.pack_start(hdr, False, False, 0)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sw.add(vbox)
        root.pack_start(sw, True, True, 0)

        scr = Wnck.Screen.get_default()
        scr.force_update()
        wins = [w for w in scr.get_windows()
                if not w.is_skip_tasklist()
                and w.get_window_type() not in (Wnck.WindowType.DESKTOP, Wnck.WindowType.DOCK)
                and "rsaarm" not in (w.get_class_group_name() or "").lower()
                and w.get_name() != "Представление задач"]

        if not wins:
            em = Gtk.Label(label="Открытых окон сейчас нет — запустите программу из меню «Пуск»")
            em.get_style_context().add_class("tv-sub")
            em.set_margin_top(60)
            vbox.pack_start(em, False, False, 0)
        else:
            for w in wins:
                c = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                c.get_style_context().add_class("tv-card")
                pix = w.get_icon()
                if pix:
                    img = Gtk.Image.new_from_pixbuf(pix.scale_simple(28, 28, 2))
                else:
                    img = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.LARGE_TOOLBAR)
                c.pack_start(img, False, False, 0)

                act_btn = Gtk.Button()
                act_btn.get_style_context().add_class("tv-btn")
                tl = Gtk.Label(label=w.get_name() or "Окно")
                tl.set_halign(Gtk.Align.START)
                tl.set_ellipsize(Pango.EllipsizeMode.END)
                tl.set_max_width_chars(38)
                act_btn.add(tl)
                xid = w.get_xid()
                act_btn.connect("clicked", lambda _b, x=xid: self._focus(x))
                c.pack_start(act_btn, True, True, 0)

                for lbl, tip, act in (
                    ("◧ Влево", "Прикрепить к левой половине", ("snap", "left")),
                    ("◨ Вправо", "Прикрепить к правой половине", ("snap", "right")),
                    ("⬜ Весь экран", "Развернуть окно", ("snap", "up")),
                    ("✕", "Закрыть окно", ("close", "")),
                ):
                    b = Gtk.Button(label=lbl)
                    b.set_tooltip_text(tip)
                    b.get_style_context().add_class("tv-btn")
                    if act[0] == "close":
                        b.get_style_context().add_class("tv-close")
                    b.connect("clicked", lambda _b, x=xid, a=act: self._act(x, a))
                    c.pack_start(b, False, False, 0)
                vbox.pack_start(c, False, False, 0)

        self.connect("size-allocate", self._shape)
        self.connect("key-press-event", lambda _w, ev: Gtk.main_quit() if ev.keyval == Gdk.KEY_Escape else False)
        self.connect("focus-out-event", lambda *_: GLib.timeout_add(120, lambda: (Gtk.main_quit(), False)[1]))
        self.show_all()
        gscr = Gdk.Screen.get_default()
        self.move((gscr.get_width() - W) // 2, (gscr.get_height() - H - 52) // 2)
        self.present()

    def _shape(self, _w, alloc):
        w, h, r = alloc.width, alloc.height, 16
        if w < 20 or h < 20 or not self.get_window():
            return
        surf = cairo.ImageSurface(cairo.FORMAT_A1, w, h)
        cr = cairo.Context(surf)
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgba(1, 1, 1, 1)
        cr.arc(w - r, r, r, -math.pi / 2, 0)
        cr.arc(w - r, h - r, r, 0, math.pi / 2)
        cr.arc(r, h - r, r, math.pi / 2, math.pi)
        cr.arc(r, r, r, math.pi, 1.5 * math.pi)
        cr.close_path()
        cr.fill()
        self.get_window().shape_combine_region(Gdk.cairo_region_create_from_surface(surf), 0, 0)

    def _focus(self, xid):
        self.hide()
        subprocess.Popen(["xdotool", "windowactivate", str(xid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        Gtk.main_quit()

    def _act(self, xid, act):
        self.hide()
        if act[0] == "close":
            subprocess.Popen(["wmctrl", "-ic", hex(xid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(["/usr/local/bin/rsaarm-snap", act[1], str(xid)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        Gtk.main_quit()


if __name__ == "__main__":
    GLib.set_prgname("kvorix-taskview")
    TaskView()
    Gtk.main()
