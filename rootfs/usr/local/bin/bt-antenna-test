#!/bin/bash
LOG=/var/log/bttest.log
if [ -z "$DETACHED" ]; then
  DETACHED=1 setsid "$0" "$@" </dev/null >/dev/null 2>&1 &
  echo "Тест запущен в фоне. Через ~10 секунд приставка пропадёт из сети."
  echo "Лог: $LOG. Вернётся сама за ~1,5 минуты."
  exit 0
fi
exec >"$LOG" 2>&1
echo "=== $(date) СТАРТ ТЕСТА АНТЕННЫ ==="
( sleep 200; echo "$(date) СТРАХОВКА: перезагрузка"; /sbin/reboot ) &
WD=$!
echo "--- выгружаю драйвер Wi-Fi"
modprobe -r brcmfmac_wcc 2>&1
modprobe -r brcmfmac 2>&1
sleep 3
echo "--- состояние BT без Wi-Fi:"
hciconfig 2>&1
hciconfig hci0 reset 2>&1
hciconfig hci0 up 2>&1
sleep 2
btmgmt power on 2>&1 | tail -2
btmgmt discov yes 2>&1 | tail -2
echo "--- ПОИСК 30 СЕКУНД БЕЗ Wi-Fi:"
timeout 35 btmgmt find 2>&1
echo "--- повторный поиск, классический:"
timeout 15 hcitool inq --length 10 2>&1
echo "--- возвращаю Wi-Fi"
modprobe brcmfmac 2>&1
sleep 20
if ping -c2 -W3 192.168.0.1 >/dev/null 2>&1; then
  echo "$(date) Wi-Fi ВЕРНУЛСЯ, отменяю страховочную перезагрузку"
  kill $WD 2>/dev/null
else
  echo "$(date) Wi-Fi НЕ вернулся — перезагрузка через ~100 секунд"
fi
echo "=== $(date) КОНЕЦ ==="
