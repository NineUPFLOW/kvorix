#!/bin/bash
L=/tmp/live-a.log
JENV="DISPLAY=:0 XAUTHORITY=/home/agent/.Xauthority DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus XDG_RUNTIME_DIR=/run/user/1001"

open_window() {
    if ! pgrep -f 'tail -n 60 -F /tmp/live-a[.]log' >/dev/null 2>&1; then
        env $JENV setsid xfce4-terminal --title="Агент-A — журнал" --geometry=76x30+770+30 \
            --font="Monospace 10" -x tail -n 60 -F /tmp/live-a.log >/dev/null 2>&1 < /dev/null &
    fi
}
ensure_watchdog() {
    local old; old=$(cat /tmp/.live-a-journal-close.pid 2>/dev/null || true)
    [ -n "$old" ] && kill "$old" 2>/dev/null
    setsid bash -c '
        echo $$ > /tmp/.live-a-journal-close.pid
        end=$(( $(date +%s) + 3600 ))
        while [ "$(date +%s)" -lt "$end" ]; do
            sleep 15
            age=$(( $(date +%s) - $(stat -c %Y /tmp/live-a.log 2>/dev/null || echo 0) ))
            [ "$age" -ge 600 ] && break
        done
        rm -f /tmp/.live-a-journal-close.pid
        pkill -f "tail -n 60 -F /tmp/live-a[.]log" 2>/dev/null
        exit 0
    ' >/dev/null 2>&1 < /dev/null &
}
case "${1:-}" in --show|show) [ "${KVORIX_JOURNAL_BUTTON:-}" = 1 ] && open_window && ensure_watchdog; exit 0;; esac
ensure_watchdog
printf '\n\033[1;35m%s\033[0m \033[1;33m[A]$\033[0m \033[1;33m$\033[0m %s\n' "$(date +%H:%M:%S)" "$*" >> $L
bash -c "$*" 2>&1 | sed 's/^/[A] /' | tee -a $L
exit ${PIPESTATUS[0]}
