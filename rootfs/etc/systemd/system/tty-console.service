[Unit]
Description=Графическая консоль на телевизоре (Xorg + urxvt на tty2)
Conflicts=getty@tty2.service
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/xinit /usr/local/bin/console-session -- :0 vt2 -nolisten tcp -noreset
ExecStartPost=/usr/bin/chvt 2
Restart=always
RestartSec=5
TTYPath=/dev/tty2
StandardInput=tty
StandardOutput=journal

[Install]
WantedBy=multi-user.target
